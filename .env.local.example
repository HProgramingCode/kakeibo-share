# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Google OAuth（ホスト型 Supabase）: Dashboard → Authentication → Providers → Google。
# .env の project-ref（URL のサブドメイン）と、設定しているプロジェクトが一致していること。
# Google Cloud のリダイレクト URI は https://<同じ-ref>.supabase.co/auth/v1/callback のみ。
#
# `supabase start`（ローカル API）を URL に使う場合: supabase/config.toml の [auth.external.google] を
# enabled = true にし、SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / SECRET を CLI 用 .env に設定。
